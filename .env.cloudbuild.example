# Copia este archivo como .env.cloudbuild y reemplaza los valores REPLACE_*
# No subas .env.cloudbuild al repositorio.

ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# Neon / PostgreSQL
ConnectionStrings__Default=Host=REPLACE_NEON_HOST;Port=5432;Database=REPLACE_DATABASE;Username=REPLACE_USERNAME;Password=REPLACE_PASSWORD;SSL Mode=Require

# JWT: genera una clave aleatoria de 32+ caracteres
Jwt__Key=REPLACE_WITH_LONG_RANDOM_JWT_KEY
Jwt__Issuer=EventFlow
Jwt__Audience=EventFlowClients
Jwt__AccessMinutes=15
Jwt__RefreshDays=30

# Frontends públicos
App__PublicUrl=https://REPLACE_WEB_DOMAIN
Cors__AllowedOrigins__0=https://REPLACE_WEB_DOMAIN

# Archivos (local es efímero en Cloud Run; usa un proveedor externo para producción)
Storage__Provider=local
Storage__LocalPath=/app/uploads

# OAuth opcional
Google__ClientId=
Google__ClientSecret=

# Déjalo desactivado en la API productiva
SeedDemoData__Enabled=false
