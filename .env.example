DB_URL=jdbc:postgresql://localhost:5432/eventflow_db
DB_USERNAME=eventflow_app
DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
# Safe Supabase profile uses runtime credentials; standalone Flyway uses migrator credentials.
DB_RUNTIME_USERNAME=eventflow_runtime
DB_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_PASSWORD
DB_MIGRATOR_USERNAME=eventflow_migrator
DB_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=5080
# Base64 de al menos 32 bytes. Ejemplo: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_KEY
# Clave estable para impedir duplicados en encuestas anónimas. No rotarla mientras existan encuestas activas.
# SURVEY_ANONYMITY_KEY=
FRONTEND_URL=http://localhost:8081
AUTH_DEEP_LINK_BASE=eventflow://auth
AUTH_EXPOSE_TOKENS=false
AUTH_MAIL_REQUIRED=false
ACCOUNT_DELETION_GRACE_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=<comma-separated-web-android-ios-client-ids>
GOOGLE_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=eventflow
BOOTSTRAP_ADMIN_EMAIL=
# Configura estas variables si se enviarán correos reales.
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=no-reply@example.com
MAIL_USERNAME=
MAIL_PASSWORD=<smtp-password>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
EXPO_PUSH_ACCESS_TOKEN=<server-side-expo-access-token>
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
