# Runtime
ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# PostgreSQL / Neon
ConnectionStrings__Default=Host=localhost;Port=5432;Database=eventflow;Username=eventflow;Password=change-me;SSL Mode=Prefer

# JWT - use Secret Manager for Jwt__Key in Cloud Run
Jwt__Key=replace-with-at-least-32-random-characters
Jwt__Issuer=EventFlow
Jwt__Audience=EventFlowClients
Jwt__AccessMinutes=15
Jwt__RefreshDays=30

# Public clients and CORS. Add __1, __2, etc. for additional origins.
App__PublicUrl=http://localhost:5173
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:8081

# File storage
Storage__Provider=local
Storage__LocalPath=/app/uploads

# Optional Google OAuth
Google__ClientId=
Google__ClientSecret=

# Migration Job only. Keep false in production unless this is a demo environment.
SeedDemoData__Enabled=false
